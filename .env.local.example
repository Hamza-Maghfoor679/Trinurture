# SheetDB endpoint for saving leads to Google Sheets
SHEETDB_API_URL=https://sheetdb.io/api/v1/your-sheet-id

# Resend API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender address in Resend (e.g. TriNurture <hello@yourdomain.com>)
RESEND_FROM_EMAIL=TriNurture <hello@yourdomain.com>

# Public URL of the 3-Pillar Research Blueprint PDF
BLUEPRINT_PDF_URL=https://your-cdn.example.com/trinurture-3-pillar-blueprint.pdf
