# Required — Resend API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required — verified sender (testing: TriNurture <onboarding@resend.dev>)
RESEND_FROM_EMAIL=TriNurture <onboarding@resend.dev>

# Required — your inbox for new-lead notifications
NOTIFY_EMAIL=you@example.com

# Optional — SheetDB endpoint for Google Sheets (skipped if empty)
SHEETDB_API_URL=https://sheetdb.io/api/v1/your-sheet-id

# Optional — public PDF URL for the download button (attachment is always sent from public/blueprint.pdf)
# After deploy: https://your-app.vercel.app/blueprint.pdf
BLUEPRINT_PDF_URL=https://your-cdn.example.com/blueprint.pdf

# Optional — used to build /blueprint.pdf link if BLUEPRINT_PDF_URL is empty
NEXT_PUBLIC_SITE_URL=http://localhost:3000
