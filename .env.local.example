# Required — Resend API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required — verified sender on your domain (Resend → Domains)
RESEND_FROM_EMAIL=TriNurture <info@trinurture.com>

# Required — your inbox for new-lead and new-order notifications
NOTIFY_EMAIL=you@example.com

# Optional — SheetDB endpoint for free Blueprint leads (skipped if empty)
SHEETDB_API_URL=https://sheetdb.io/api/v1/your-leads-sheet-id

# Required for Activity Pack orders — SEPARATE SheetDB API from leads
# Sheet columns: name, email, whatsapp, submitted_at, status
ORDERS_SHEETDB_API_URL=https://sheetdb.io/api/v1/your-orders-sheet-id

# Optional — public PDF URL used as the download CTA in the confirmation email
BLUEPRINT_PDF_URL=https://your-cdn.example.com/blueprint.pdf

# Optional — used to build /blueprint.pdf link if BLUEPRINT_PDF_URL is empty
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment details (sent only in private order confirmation emails — never on the public site)
# Use \n for line breaks inside a single-line value, or a quoted multiline string
PAYMENT_BANK_DETAILS="Bank Name: Your Bank\nAccount Title: Your Name\nAccount Number: 0000000000\nIBAN: PK00XXXX0000000000000000"

PAYMENT_MOBILE_WALLET_DETAILS="JazzCash: 03XXXXXXXXX (Account Title)\nEasypaisa: 03XXXXXXXXX (Account Title)"

# Business WhatsApp for customers to send payment proof (email only — not shown on site)
BUSINESS_WHATSAPP_NUMBER=+92XXXXXXXXXX
